{
  "$schema": "https://opencode.ai/config.json",
  "model": "byteplus-plan/deepseek-v4.1-flash",
  "provider": {
    "byteplus-plan": {
      "npm": "@ai-sdk/openai",
      "name": "BytePlus ModelArk (Coding Plan)",
      "options": {
        "baseURL": "https://ark.ap-southeast.bytepluses.com/api/coding/v3",
        "apiKey": "{file:~/.secrets/byteplus-key}"
      },
      "models": {
        "ark-code-latest": {
          "name": "ark-code-latest (router, backend varies)",
          "limit": {
            "context": 256000,
            "output": 32000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "glm-5.2": {
          "name": "glm-5.2",
          "limit": {
            "context": 1024000,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "glm-5.3-flash": {
          "name": "glm-5.3-flash",
          "limit": {
            "context": 1024000,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "limit": {
            "context": 1024000,
            "output": 65536
          }
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "limit": {
            "context": 1024000,
            "output": 65536
          }
        },
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "limit": {
            "context": 1024000,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "bytedance-seed-code": {
          "name": "bytedance-seed-code (serves dola-seed-2.0-lite)",
          "limit": {
            "context": 1024000,
            "output": 65536
          }
        },
        "dola-seed-2.0-pro": {
          "name": "dola-seed-2.0-pro",
          "limit": {
            "context": 256000,
            "output": 32000
          }
        },
        "dola-seed-2.0-code": {
          "name": "dola-seed-2.0-code",
          "limit": {
            "context": 256000,
            "output": 32000
          }
        },
        "kimi-k2.5": {
          "name": "kimi-k2.5 (serves dola-seed-2.0-pro)",
          "limit": {
            "context": 256000,
            "output": 32000
          }
        }
      }
    }
  }
}

  "lines": [
    {
      "i": 0,
      "text": "غَيْرُ مُجْدٍ فِي مِلَّتِي وَاعْتِقَادِي"
    },
    {
      "i": 1,
      "text": "نَوْحُ بَاكٍ وَلَا تَرَنُّمُ شَادِ..."
    },
    {
      "i": 2,
      "text": "غَيْرُ مُجْدٍ فِي مِلَّتِي وَاعْتِقَادِي"
    },
    {
      "i": 3,
      "text": "نَوْحُ بَاكٍ وَلَا تَرَنُّمُ شَادِ..."
    },
    {
      "i": 4,
      "text": "وَشَبِيهٌ صَوْتُ النَّعِيِّ إِذَا قِيسَ"
    },
    {
      "i": 5,
      "text": "بِصَوْتِ الْبَشِيرِ فِي كُلِّ نَادِ..."
    },
    {
      "i": 6,
      "text": "أَبَكَتْ تِلْكُمُ الْحَمَامَةُ أَمْ غَنَّتْ"
    },
    {
      "i": 7,
      "text": "عَلَى فَرْعِ غُصْنِهَا الْمَيَّادِ..."
    },
    {
      "i": 8,
      "text": "صَاحِ هَذِي قُبُورُنَا تَمْلَأُ الرُّحْبَ"
    },
    {
      "i": 9,
      "text": "فَأَيْنَ الْقُبُورُ مِنْ عَهْدِ عَادِ..."
    },
    {
      "i": 10,
      "text": "خَفِّفِ الْوَطْءَ مَا أَظُنُّ أَدِيمَ الْأَرْضِ"
    },
    {
      "i": 11,
      "text": "إِلَّا مِنْ هَذِهِ الْأَجْسَادِ..."
    },
    {
      "i": 12,
      "text": "وَقَبِيحٌ بِنَا وَإِنْ قَدُمَ الْعَهْدُ"
    },
    {
      "i": 13,
      "text": "هَوَانُ الْآبَاءِ وَالْأَجْدَادِ..."
    },
    {
      "i": 14,
      "text": "سِرْ إِنِ اسْطَعْتَ فِي الْهَوَاءِ رُوَيْدًا"
    },
    {
      "i": 15,
      "text": "لَا اخْتِيَالًا عَلَى رُفَاتِ الْعِبَادِ..."
    },
    {
      "i": 16,
      "text": "رُبَّ لَحْدٍ قَدْ صَارَ لَحْدًا مِرَارًا"
    },
    {
      "i": 17,
      "text": "ضَاحِكٍ مِنْ تَزَاحُمِ الْأَضْدَادِ..."
    },
    {
      "i": 18,
      "text": "وَدَفِينٍ عَلَى بَقَايَا دَفِينٍ"
    },
    {
      "i": 19,
      "text": "فِي طَوِيلِ الْأَزْمَانِ وَالْآبَادِ..."
    },
    {
      "i": 20,
      "text": "فَاسْأَلِ الْفَرْقَدَيْنِ عَمَّنْ أَحَسَّا"
    },
    {
      "i": 21,
      "text": "مِنْ قَبِيلٍ وَآنَسَا مِنْ بِلَادِ..."
    },
    {
      "i": 22,
      "text": "كَمْ أَقَامَا عَلَى زَوَالِ نَهَارٍ"
    },
    {
      "i": 23,
      "text": "وَأَنَارَا لِمُدْلِجٍ فِي سَوَادِ..."
    },
    {
      "i": 24,
      "text": "خَفِّفِ الْوَطْءَ مَا أَظُنُّ أَدِيمَ الْأَرْضِ"

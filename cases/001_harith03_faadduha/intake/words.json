  "lines": [
    {
      "i": 0,
      "text": "أَيُّهَا النَّاطِقُ الْمُرَقِّشُ عَنَّا عِنْدَ عَمْرٍ"
    },
    {
      "i": 1,
      "text": "وَهَلْ لِذَاكَ بَقَاءُو..."
    },
    {
      "i": 2,
      "text": "أَيُّهَا النَّاطِقُ الْمُرَقِّشُ عَنَّا عِنْدَ عَمْرٍ"
    },
    {
      "i": 3,
      "text": "وَهَلْ لِذَاكَ بَقَاءُو..."
    },
    {
      "i": 4,
      "text": "لَا تَخَلْنَا عَلَى غِرَاتِكَ"
    },
    {
      "i": 5,
      "text": "إِنَّا قَبْلُ مَا قَدْ وَشَى بِنَا الْأَعْدَاءُو..."
    },
    {
      "i": 6,
      "text": "فَبَقِينَا عَلَى الشَّنَاءَةِ تَنْمِينَا حُصُونٌ"
    },
    {
      "i": 7,
      "text": "وَعِزَّةٌ قَعْسَاءُو..."
    },
    {
      "i": 8,
      "text": "قَبْلَ مَا الْيَوْمِ بَيَّضَتْ بِعُيُونِ النَّاسِ"
    },
    {
      "i": 9,
      "text": "فِيهَا تَغَيُّظٌ وَإِبَاءُو..."
    },
    {
      "i": 10,
      "text": "وَكَأَنَّ الْمَنُونَ تَرْدِي بِنَا أَرْعَنَ جَوْنًا"
    },
    {
      "i": 11,
      "text": "يَنْجَابُ عَنْهُ الْعَمَاءُو..."
    },
    {
      "i": 12,
      "text": "مُكْفَهِرًّا عَلَى الْحَوَادِثِ"
    },
    {
      "i": 13,
      "text": "لَا تَرْتُوهُ لِلدَّهْرِ مُؤْيِدٌ صَمَّاءُو..."
    },
    {
      "i": 14,
      "text": "أَيَّمَا خُطَّةٍ أَرَدْتُمْ فَأَدُّوهَا إِلَيْنَا"
    },
    {
      "i": 15,
      "text": "تَمْشِي بِهَا الْأَمْلَاءُو..."
    },
    {
      "i": 16,
      "text": "إِنْ نَبَشْتُمْ مَا بَيْنَ مِلْحَةَ فَالصَّاقِبِ"
    },
    {
      "i": 17,
      "text": "فِيهِ الْأَمْوَاتُ وَالْأَحْيَاءُو..."
    },
    {
      "i": 18,
      "text": "أَوْ نَقَشْتُمْ فَالنَّقْشُ تَجْشَمُهُ النَّاسُ"
    },
    {
      "i": 19,
      "text": "وَفِيهِ الصَّلَاحُ وَالْإِبْرَاءُو..."
    },
    {
      "i": 20,
      "text": "أَوْ سَكَتُّمْ عَنَّا فَكُنَّا كَمَنْ أَغْمَضَ عَيْنًا"
    },
    {
      "i": 21,
      "text": "فِي جَفْنِهَا الْأَقْذَاءُو..."
    },
    {
      "i": 22,
      "text": "أَوْ مَنَعْتُمْ مَا تُسْأَلُونَ"
    },
    {
      "i": 23,
      "text": "فَمَنْ حُدِّثْتُمُوهُ لَهُ عَلَيْنَا الْعَلَاءُو..."
    },
    {
      "i": 24,
      "text": "أَوْ مَنَعْتُمْ مَا تُسْأَلُونَ"
    },
    {
      "i": 25,
      "text": "فَمَنْ حُدِّثْتُمُوهُ لَهُ عَلَيْنَا الْعَلَاءُو..."
    }
